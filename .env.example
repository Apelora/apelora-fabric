# Copy to .env (git-ignored) for local development. No secrets belong in this file.

# Address the Apelora control plane listens on (loopback by default). Any other address needs
# TLS of its own or a declared TLS-terminating proxy in front, or the control plane refuses to start.
APELORA_API_ADDR=127.0.0.1:8080
# APELORA_TLS_CERT=/path/outside/repo/api.crt   # PEM chain; with APELORA_TLS_KEY the API serves HTTPS
# APELORA_TLS_KEY=/path/outside/repo/api.key
# APELORA_BEHIND_PROXY=1                         # plain HTTP, only a TLS-terminating proxy reaches it (infra/serve/)
# APELORA_TRUSTED_PROXIES=10.0.0.5               # proxies whose X-Forwarded-For is believed (addresses or CIDR ranges)

# Rate limits (per API process, in memory). PER_MIN = tokens per minute, BURST = most saved up; 0 turns one off.
# APELORA_RATE_LIMIT_PUBLIC_PER_MIN=120          # per client address: public routes and requests without a token
# APELORA_RATE_LIMIT_PUBLIC_BURST=60
# APELORA_RATE_LIMIT_FAILED_AUTH_PER_MIN=10      # per client address: refused tokens; when spent, tokens from it are refused
# APELORA_RATE_LIMIT_FAILED_AUTH_BURST=20
# APELORA_RATE_LIMIT_WRITES_PER_MIN=600          # per signed-in caller: POST/PUT/PATCH/DELETE
# APELORA_RATE_LIMIT_WRITES_BURST=200
# APELORA_RATE_LIMIT_MAX_CLIENTS=10000           # buckets kept per limit (memory bound)

# Where the Fabric Console dev server proxies /api requests.
APELORA_API_URL=http://127.0.0.1:8080
# Build time (npm run build): where this build's source is offered on /licenses, as the AGPL's network clause
# requires. Defaults to the repository in CITATION.cff; set it when you run a modified Apelora.
# APELORA_SOURCE_URL=https://git.example.internal/apelora-fabric

# Phase 03+: Incus endpoint for an explicitly designated, disposable test cluster.
# Client certificate and key paths point OUTSIDE the repository.
# APELORA_INCUS_URL=https://incus-test.example.internal:8443
# APELORA_INCUS_CLIENT_CERT=/path/outside/repo/client.crt
# APELORA_INCUS_CLIENT_KEY=/path/outside/repo/client.key
# APELORA_INCUS_SERVER_CERT=/path/outside/repo/server.crt   # pinned; no public CA is trusted
# APELORA_INCUS_TLS_SERVER_NAME=unspecified                  # only if the certificate does not name the host
# Optional: enforce designs' connections on per-application OVN networks using this uplink
# network (the deploy project needs features.networks and restricted.networks.uplinks).
# APELORA_NETWORK_UPLINK=incusbr0
# Optional, with the uplink: routed IPv4 range (in the uplink's ipv4.routes and the deploy
# project's restricted.networks.subnets) for service addresses of stateless modules.
# APELORA_SERVICE_ADDRESSES=198.18.100.0/28
# Worker only: seconds between replica supervisor passes (restores lost stateless replicas; 0 = off).
# APELORA_SUPERVISE_SECS=30
# Worker only: a member must be Offline this long before its stateless replicas are substituted.
# APELORA_RECOVER_AFTER_SECS=120
# Worker only: a replica failing its service port check this long is unhealthy; a stateless one
# unhealthy this long is restarted (at most once per 5 minutes per instance).
# APELORA_HEALTH_FAIL_AFTER_SECS=20
# APELORA_HEALTH_RESTART_AFTER_SECS=60
# Control plane only, optional: an unrestricted identity for cluster administration (join
# tokens; ADR 0003). The client certificate above should be restricted to the deploy projects.
# APELORA_INCUS_ADMIN_CLIENT_CERT=/path/outside/repo/admin.crt
# APELORA_INCUS_ADMIN_CLIENT_KEY=/path/outside/repo/admin.key
# The worker uses the same APELORA_INCUS_* settings. Incus projects Apelora may change
# (comma-separated; default "apelora"); instances elsewhere are never created, stopped or deleted.
# APELORA_DEPLOY_PROJECTS=apelora

# Terminal and PowerShell sessions into modules (control plane; see docs/architecture/IDENTITY-AND-AUTHORIZATION.md section 7).
# APELORA_CONSOLE_ACCESS=disabled          # turns the feature off
# APELORA_CONSOLE_UID=1000                 # user inside Linux modules; pick one WITHOUT sudo
# APELORA_CONSOLE_GID=1000
# APELORA_CONSOLE_IDLE_SECS=900            # no typing for this long ends a session
# APELORA_CONSOLE_MAX_SECS=3600            # absolute limit
# APELORA_CONSOLE_MAX_SESSIONS=3           # open sessions plus unused tickets per person
# APELORA_CONSOLE_POWERSHELL=enabled       # off until verified against a Windows guest
# Browser origins besides the API's own host, by name (no wildcard). Needed only when the Studio and the
# Fabric Console reach the API under another host name; list both (development: http://127.0.0.1:5173,http://127.0.0.1:5174).
# APELORA_ALLOWED_ORIGINS=https://studio.example.test,https://console.example.test

# Sign-in (control plane; see docs/architecture/IDENTITY-AND-AUTHORIZATION.md section 3). Identity
# providers are normally added in the Fabric Console (Identity & Access → Sign-in); one may also be
# set here, and is then shown there read-only. No client secret: the browser uses PKCE.
# APELORA_OIDC_ISSUER=https://id.example.test/realms/main
# APELORA_OIDC_AUDIENCE=apelora-api        # the name this API has at the provider (comma-separated)
# APELORA_OIDC_CLIENT_ID=apelora-console   # public browser client; without it no sign-in button
# APELORA_OIDC_SCOPES=openid profile email
# APELORA_OIDC_LABEL=Example Corp          # shown as "Sign in with Example Corp"
# APELORA_OIDC_GROUPS_CLAIM=groups
# APELORA_OIDC_USERNAME_CLAIM=preferred_username
# APELORA_LEGACY_TOKENS=disabled           # refuse apl_ API tokens (cannot be turned back on in the Console)
# Logs (control plane and worker; see docs/runbooks/troubleshooting.md). RUST_LOG picks what is
# written (default info), e.g. info,apelora_control_plane=debug or info,apelora_incus_adapter=debug.
# RUST_LOG=info
# APELORA_LOG_FORMAT=json                  # one JSON object per line (default: text)

# Metrics (both services; docs/architecture/MONITORING.md). Constant labels on every series, so
# figures roll up per sector, site and region: lowercase letters, digits and '-' (default "default").
# APELORA_REGION=eu-west
# APELORA_SITE=fra1
# APELORA_SECTOR=s01
# Control plane: GET /metrics on the API address always needs a token with fabric.metrics.read.
# Optional separate listener WITHOUT authentication (loopback or a management network only; default off).
# APELORA_METRICS_ADDR=127.0.0.1:9470
# Worker: GET /metrics and GET /healthz without authentication (default 127.0.0.1:9471; "off" turns it off).
# APELORA_WORKER_METRICS_ADDR=127.0.0.1:9471

# Image mirrors for installations without internet access (both services; ADR 0010).
# APELORA_IMAGE_MIRRORS="https://images.upstream.example=https://images.mirror.internal,https://registry.upstream.example=https://registry.mirror.internal"
# APELORA_IMAGE_SERVERS=mirrors-only      # refuse any image server that is not a mirror (default: any)

# Apelora's database backups: the directory the backup script writes to (read only; shown under Administration).
# APELORA_DB_BACKUP_DIR=/srv/apelora-backups
