# Copy to .env (git-ignored) for local development. No secrets belong in this file.

# Address the Apelora control plane listens on (loopback by default).
APELORA_API_ADDR=127.0.0.1:8080

# Where the Fabric Console dev server proxies /api requests.
APELORA_API_URL=http://127.0.0.1:8080

# Phase 03+: Incus endpoint for an explicitly designated, disposable test cluster.
# Client certificate and key paths point OUTSIDE the repository.
# APELORA_INCUS_URL=https://incus-test.example.internal:8443
# APELORA_INCUS_CLIENT_CERT=/path/outside/repo/client.crt
# APELORA_INCUS_CLIENT_KEY=/path/outside/repo/client.key
# APELORA_INCUS_SERVER_CERT=/path/outside/repo/server.crt   # pinned; no public CA is trusted
# APELORA_INCUS_TLS_SERVER_NAME=unspecified                  # only if the certificate does not name the host
