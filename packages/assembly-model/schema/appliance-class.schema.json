{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "category": {
      "type": "string",
      "enum": [
        "Custom",
        "Network & Security",
        "Security & Identity",
        "Load Balancing",
        "Web & Application",
        "Databases & Cache",
        "Messaging & Streaming",
        "Search & Analytics",
        "Storage",
        "Monitoring",
        "Operating Systems",
        "Microsoft Windows",
        "Utilities"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "iconAssetPath": {
      "type": "string"
    },
    "runtimeImage": {
      "type": "object",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "architectures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "x86_64",
          "aarch64"
        ]
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "direction": {
            "type": "string",
            "enum": [
              "input",
              "output"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "network",
              "http",
              "tcp",
              "postgres",
              "mysql",
              "redis",
              "amqp",
              "s3",
              "metrics",
              "kafka",
              "pulsar",
              "mqtt",
              "nats",
              "mongodb",
              "cassandra",
              "memcached",
              "grpc",
              "ldap",
              "smtp",
              "syslog",
              "nfs",
              "mssql",
              "smb",
              "rdp"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "multiplicity": {
            "type": "string",
            "enum": [
              "one",
              "many"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "id",
          "name",
          "direction",
          "type",
          "optional",
          "multiplicity"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 256
        },
        "memoryMiB": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4194304
        }
      },
      "required": [
        "cpu",
        "memoryMiB"
      ],
      "additionalProperties": false
    },
    "properties": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int",
              "bool",
              "enum",
              "secret"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 160
          },
          "group": {
            "type": "string",
            "maxLength": 32
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "appliances": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "classRef": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              "resources": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 256
                  },
                  "memoryMiB": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 4194304
                  }
                },
                "required": [
                  "cpu",
                  "memoryMiB"
                ],
                "additionalProperties": false
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "input",
                        "output"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "network",
                        "http",
                        "tcp",
                        "postgres",
                        "mysql",
                        "redis",
                        "amqp",
                        "s3",
                        "metrics",
                        "kafka",
                        "pulsar",
                        "mqtt",
                        "nats",
                        "mongodb",
                        "cassandra",
                        "memcached",
                        "grpc",
                        "ldap",
                        "smtp",
                        "syslog",
                        "nfs",
                        "mssql",
                        "smb",
                        "rdp"
                      ]
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "multiplicity": {
                      "type": "string",
                      "enum": [
                        "one",
                        "many"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "direction",
                    "type",
                    "optional",
                    "multiplicity"
                  ],
                  "additionalProperties": false
                }
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "classRef",
              "resources",
              "ports"
            ],
            "additionalProperties": false
          }
        },
        "connections": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "source": {
                "type": "object",
                "properties": {
                  "applianceId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "portId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  }
                },
                "required": [
                  "applianceId",
                  "portId"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "applianceId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "portId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  }
                },
                "required": [
                  "applianceId",
                  "portId"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "source",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "links": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "tag": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
              },
              "endpoint": {
                "type": "object",
                "properties": {
                  "applianceId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "portId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  }
                },
                "required": [
                  "applianceId",
                  "portId"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "tag",
              "endpoint"
            ],
            "additionalProperties": false
          }
        },
        "layout": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 64,
                "maximum": 2000
              },
              "height": {
                "type": "number",
                "minimum": 48,
                "maximum": 2000
              },
              "custom": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height",
              "custom"
            ],
            "additionalProperties": false
          }
        },
        "exposes": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "inner": {
                "minItems": 1,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "applianceId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "portId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,47}$"
                    }
                  },
                  "required": [
                    "applianceId",
                    "portId"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "port",
              "inner"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "appliances",
        "connections",
        "layout",
        "exposes"
      ],
      "additionalProperties": false
    },
    "custom": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "version",
    "displayName",
    "category",
    "summary",
    "iconAssetPath",
    "runtimeImage",
    "architectures",
    "ports",
    "resources"
  ],
  "additionalProperties": false
}
