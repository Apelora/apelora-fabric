        "type": "object",
        "description": "An instance Apelora should create. Apelora's ownership marker is added on creation.",
        "required": [
          "project",
          "name",
          "kind",
          "source"
        ],
        "properties": {
          "architectures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Architectures the image is known to run on (see [`ARCHITECTURES`]); empty allows any.\nChecked against the cluster before creating and against the instance Incus created."
          },
          "config": {
            "type": "object",
            "description": "Extra instance config; keys under `user.apelora.` are reserved.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "kind": {
            "$ref": "#/components/schemas/InstanceKind",
            "description": "`container` (system or OCI) or `virtual-machine`."
