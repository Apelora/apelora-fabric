          "protocol",
          "server",
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "description": "Alias such as `debian/13` or, for OCI, `repository:tag`. Pin an OCI image by digest:\n`repository@sha256:<64 hex digits>`."
          },
          "fingerprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pins a simplestreams image: the full SHA-256 fingerprint Incus gives it. The instance\nmust then be built from exactly this image."
          },
          "protocol": {
            "$ref": "#/components/schemas/ImageProtocol"
          },
          "server": {
            "type": "string",
            "description": "Image server URL, e.g. a simplestreams server or an OCI registry."
          }
        }
      },
      "IncusStatus": {
        "type": "object",
        "description": "What the control plane knows about its Incus connection.",
        "required": [
          "connected",
          "serverVersion"
