  "components": {
    "schemas": {
      "AuditItem": {
        "type": "object",
        "required": [
          "id",
          "at",
          "actor",
          "action",
          "target",
          "detail"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "description": "RFC 3339 timestamp."
          },
          "detail": {
            "type": "object"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "target": {
            "type": "string"
          }
        }
      },
      "AuditList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditItem"
            }
          }
        }
      },
      "AuthMode": {
        "type": "string",
        "enum": [
          "tokens",
          "disabled-development"
        ]
      },
      "Check": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Stable identifier, e.g. `kernel-version`."
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "pass",
          "not-checked",
          "warn",
          "fail"
        ]
      },
      "ClusterMember": {
        "type": "object",
        "description": "Observed state of an Incus cluster member (\"minion\" in the UI).",
        "required": [
          "name",
          "url",
          "roles",
          "status",
          "message",
          "architecture",
          "failureDomain",
          "database",
          "groups"
        ],
        "properties": {
          "architecture": {
            "type": "string"
          },
          "database": {
            "type": "boolean"
          },
          "failureDomain": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
